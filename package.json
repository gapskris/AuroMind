{
  "name": "auromind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"console.log('Static site ready')\"",
    "lint": "node --check server.js && node --check assets/js/portal.js",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:supabase": "node scripts/validate-supabase-config.mjs",
    "validate:cloudflare": "node scripts/validate-cloudflare-config.mjs",
    "validate:secrets": "node scripts/validate-secret-exposure.mjs",
    "validate:all": "node scripts/validate-env.mjs && node scripts/validate-supabase-config.mjs && node scripts/validate-cloudflare-config.mjs && node scripts/validate-secret-exposure.mjs",
    "migrate:workflow": "node scripts/migration-workflow.mjs",
    "migrate:preflight": "node scripts/migration-workflow.mjs --preflight",
    "migrate:preflight:remote": "node scripts/migration-workflow.mjs --preflight-remote",
    "migrate:manifest": "node scripts/migration-workflow.mjs --manifest",
    "migrate:bundle": "node scripts/migration-workflow.mjs --bundle",
    "migrate:verify-sql": "node scripts/migration-workflow.mjs --verify-sql",
    "diagnose:network": "node scripts/diagnose-network.mjs",
    "test": "node --test *.test.js",
    "test:b4": "node --test b4-platform-services.test.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supabase": "3.4.0"
  }
}
