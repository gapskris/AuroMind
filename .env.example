# ==============================================================================
# AuroMasti — Minimal Environment Configuration Template (.env.example)
# Target Release: January 1, 2027 | Architecture: Local-First Sanctuary Games
#
# MINIMAL CREDENTIAL PRINCIPLE:
# For normal application runtime and integration testing, the ONLY secret required
# from the developer is the public SUPABASE_ANON_KEY.
#
# INSTRUCTIONS FOR DEVELOPER:
# 1. Copy this file to '.env.local' (for local testing) or '.env.staging.local' (for staging).
# 2. Enter your SUPABASE_ANON_KEY from the Supabase Dashboard.
# 3. Direct DB connectivity (DATABASE_URL / POSTGRES_PASSWORD) is OPTIONAL and only
#    needed if you choose to run migrations via local CLI rather than the Supabase SQL Editor.
# 4. Run 'node scripts/validate-env.mjs' to verify configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & PLATFORM (PUBLIC CONFIGURATION)
# ------------------------------------------------------------------------------
NODE_ENV=development
AUROMIND_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# [SACRED INVARIANT] Commercial monetization gate. MUST ALWAYS REMAIN false.
COMMERCIAL_GATE_ENABLED=false

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT (PUBLIC CONFIGURATION)
# Project Reference: rlqrtbjynaihdspbqtce | Region: ap-southeast-1
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID=rlqrtbjynaihdspbqtce
SUPABASE_REGION=ap-southeast-1
SUPABASE_URL=https://rlqrtbjynaihdspbqtce.supabase.co

# [MANDATORY APPLICATION RUNTIME CREDENTIAL]
# Location: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon" "public"
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ------------------------------------------------------------------------------
# 3. DIRECT POSTGRESQL CONNECTION (OPTIONAL - FOR MIGRATION SCRIPTS ONLY)
# Not needed if applying migrations via Supabase Web Dashboard SQL Editor.
# Location: Supabase Dashboard -> Project Settings -> Database -> Connection string
# ------------------------------------------------------------------------------
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.rlqrtbjynaihdspbqtce.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.rlqrtbjynaihdspbqtce.supabase.co:5432/postgres?sslmode=require
POSTGRES_HOST=db.rlqrtbjynaihdspbqtce.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_SSL=require

# ------------------------------------------------------------------------------
# 4. STORAGE & AUTH CONFIGURATION (PUBLIC CONFIGURATION)
# ------------------------------------------------------------------------------
STORAGE_AVATAR_BUCKET=avatars
STORAGE_ARTWORK_BUCKET=user-artwork
AUTH_SITE_URL=http://localhost:3000
AUTH_ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://localhost:8080/**,http://127.0.0.1:3342/**,https://staging.auromasti.pages.dev/**

# ------------------------------------------------------------------------------
# 5. CREDENTIALS EXPLICITLY NOT REQUIRED (UNNECESSARY IN CLIENT RUNTIME)
# ------------------------------------------------------------------------------
# - SUPABASE_SERVICE_ROLE_KEY: Automatically injected into Supabase Edge Functions
#   at runtime by Supabase infrastructure. Strictly FORBIDDEN in client bundles.
# - SUPABASE_JWT_SECRET: Managed internally by Supabase Auth (GoTrue).
# - SMTP_*: Managed internally in Supabase Dashboard -> Authentication -> SMTP.
# - GEMINI_API_KEY: Obsolete Studio artifact; not used in AuroMasti.
# - CLOUDFLARE_API_TOKEN: Deployment-only credential; isolated to CI/CD pipeline.
