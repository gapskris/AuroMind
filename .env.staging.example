# ==============================================================================
# AuroMasti — Staging Minimal Environment Template (.env.staging.example)
# Target: Cloudflare Pages Staging & Supabase Free Project (AuroMasti)
#
# MINIMAL CREDENTIAL PRINCIPLE:
# The ONLY mandatory credential required from the developer for staging runtime
# is the publishable SUPABASE_ANON_KEY.
#
# INSTRUCTIONS FOR DEVELOPER:
# 1. Copy this file to '.env.staging.local'
# 2. Paste your SUPABASE_ANON_KEY from the Supabase Dashboard.
# 3. If running CLI migrations, optionally enter your POSTGRES_PASSWORD.
# 4. Verify with: node scripts/validate-env.mjs --file .env.staging.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STAGING RUNTIME & IDENTITY (PUBLIC CONFIGURATION)
# ------------------------------------------------------------------------------
NODE_ENV=staging
AUROMIND_ENV=staging
PORT=8080
BASE_URL=https://staging.auromasti.pages.dev
COMMERCIAL_GATE_ENABLED=false

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT: AUROMASTI (PUBLIC CONFIGURATION)
# Project Reference: rlqrtbjynaihdspbqtce | Region: ap-southeast-1
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID=rlqrtbjynaihdspbqtce
SUPABASE_REGION=ap-southeast-1
SUPABASE_URL=https://rlqrtbjynaihdspbqtce.supabase.co

# [MANDATORY APPLICATION RUNTIME CREDENTIAL]
# Location: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon" "public"
SUPABASE_ANON_KEY=YOUR_STAGING_SUPABASE_ANON_KEY_HERE

# ------------------------------------------------------------------------------
# 3. SUPABASE CLI & MIGRATION CREDENTIALS (DEVELOPER ONLY - LOCAL SECRETS)
# These credentials are used for Supabase CLI authentication and migration preflight.
# Keep SUPABASE_ACCESS_TOKEN and SUPABASE_DB_PASSWORD strictly separate.
# NEVER substitute SUPABASE_SERVICE_ROLE_KEY for either credential!
# ------------------------------------------------------------------------------
# [SUPABASE CLI AUTHENTICATION TOKEN]
# Location: https://supabase.com/dashboard/account/tokens -> "Generate new token"
# Format: sbp_...
SUPABASE_ACCESS_TOKEN=YOUR_STAGING_SUPABASE_ACCESS_TOKEN_HERE

# [HOSTED POSTGRESQL DATABASE PASSWORD]
# Location: Supabase Dashboard -> Project Settings -> Database -> Database Password
# Used by the CLI when connecting to the hosted database for migration operations.
SUPABASE_DB_PASSWORD=YOUR_STAGING_SUPABASE_DB_PASSWORD_HERE

# Format: postgresql://postgres:[YOUR-PASSWORD]@db.rlqrtbjynaihdspbqtce.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_STAGING_SUPABASE_DB_PASSWORD_HERE@db.rlqrtbjynaihdspbqtce.supabase.co:5432/postgres?sslmode=require
POSTGRES_HOST=db.rlqrtbjynaihdspbqtce.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STAGING_SUPABASE_DB_PASSWORD_HERE
POSTGRES_SSL=require

# ------------------------------------------------------------------------------
# 4. STAGING REDIRECTS & STORAGE (PUBLIC CONFIGURATION)
# ------------------------------------------------------------------------------
AUTH_SITE_URL=https://staging.auromasti.pages.dev
AUTH_ADDITIONAL_REDIRECT_URLS=https://staging.auromasti.pages.dev/**,http://localhost:8080/**,http://localhost:3000/**,http://127.0.0.1:3342/**
STORAGE_AVATAR_BUCKET=avatars
STORAGE_ARTWORK_BUCKET=user-artwork
EDGE_TELEMETRY_INGEST_URL=https://rlqrtbjynaihdspbqtce.supabase.co/functions/v1/ingest-telemetry
EDGE_SYNC_SAVE_URL=https://rlqrtbjynaihdspbqtce.supabase.co/functions/v1/sync-save
EDGE_OWNER_METRICS_URL=https://rlqrtbjynaihdspbqtce.supabase.co/functions/v1/owner-metrics
EDGE_DELETE_ACCOUNT_URL=https://rlqrtbjynaihdspbqtce.supabase.co/functions/v1/delete-account
TELEMETRY_RETENTION_DAYS=60

# ------------------------------------------------------------------------------
# 5. CREDENTIALS EXPLICITLY NOT REQUIRED (UNNECESSARY IN CLIENT RUNTIME)
# ------------------------------------------------------------------------------
# - SUPABASE_SERVICE_ROLE_KEY: Automatically injected into Supabase Edge Functions.
# - SUPABASE_JWT_SECRET: Managed internally by Supabase Auth (GoTrue).
# - SMTP_*: Managed internally in Supabase Dashboard.
# - CLOUDFLARE_API_TOKEN: Isolated to CI/CD deployment; not needed for app runtime.
